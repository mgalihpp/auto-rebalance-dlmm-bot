# Solana RPC endpoint (mainnet or devnet). Required.
RPC_URL=

# Meteora DLMM pool address for DOGE/SOL (mainnet). Required.
# Find it on https://app.meteora.ag/dlmm — leave empty until you have it.
POOL_ADDRESS=

# Your DLMM position public key. Optional — if empty, bot monitors pool only (NoPosition).
POSITION_PUBKEY=

# Wallet private key (never commit). Only needed for live mode.
# Accepts base58 (one line, Phantom export) or JSON array (solana-keygen).
WALLET_PRIVATE_KEY=

# Poll interval in milliseconds. Default 60000.
CHECK_INTERVAL_MS=60000

# Allowed slippage in basis points, live mode only. Default 100 (=1%).
SLIPPAGE_BPS=100

# true = log only, never send transactions. Default true. Set false for live.
DRY_RUN=true

# Distance (bins) from range edge that counts as NearEdge. Default 2.
EDGE_BUFFER_BINS=2
