# Solana RPC endpoint (mainnet or devnet). Required.
RPC_URL=

# Meteora DLMM pool address for DOGE/SOL (mainnet). Required.
# Find it on https://app.meteora.ag/dlmm — leave empty until you have it.
POOL_ADDRESS=

# Your DLMM position public key. Optional — if empty, bot monitors pool only (NoPosition).
POSITION_PUBKEY=

# Wallet private key (never commit). Only needed for live mode.
# Accepts base58 (one line, Phantom export) or JSON array (solana-keygen).
WALLET_PRIVATE_KEY=

# Rebalance strategy: Spot (even), Curve (centered), BidAsk (edges, volatile).
STRATEGY=Spot

# Poll interval in milliseconds. Default 60000.
CHECK_INTERVAL_MS=60000

# Allowed slippage in basis points, live mode only. Default 100 (=1%).
SLIPPAGE_BPS=100

# true = log only, never send transactions. Default true. Set false for live.
DRY_RUN=true

# Distance (bins) from range edge that counts as NearEdge. Default 2.
EDGE_BUFFER_BINS=2

# Swap slippage in basis points. Empty = follow SLIPPAGE_BPS.
SWAP_SLIPPAGE_BPS=

# Fixed position width (bins) for rebalance. Empty = follow old position width.
POSITION_WIDTH_BINS=

# Fee compounding: true = swap+deposit total+fee (old behavior).
# false = size on principal only, fees stay claimed in wallet (web default).
COMPOUND_FEES=false

# Gas guard: native SOL kept untouched on every rebalance. Sizing and deposits
# only ever see token accounts; the SOL leg is wrapped to wSOL minus this
# reserve first. Aborts when gas is below the reserve. Default 0.02.
SOL_RESERVE_SOL=0.02

# Jito bundles (opt-in atomic path): withdraw + wrap + swap + deposit(+tip)
# land in one slot, with automatic fallback to sequential sends.
# Default false = existing sequential path, byte-for-byte as before.
JITO_ENABLED=false

# Tip paid to the Jito validator inside the last bundle transaction.
# Minimum 1000 lamports. Default 0.0005.
JITO_TIP_SOL=0.0005

# Block engine endpoint. Default mainnet; prefer the closest region, e.g.
# https://tokyo.mainnet.block-engine.jito.wtf or
# https://singapore.mainnet.block-engine.jito.wtf
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf
