RPC_URL=https://api.mainnet-beta.solana.com
POOL_ADDRESS=
# The bot manages the funded position in POOL_ADDRESS.
PRIVATE_KEY=
SLIPPAGE_BPS=50
DRY_RUN=true
COMPOUND_FEES=false
REACCUMULATE_FEES_TO_SOL=false
# Claim + sweep fees to SOL while in range once they are worth this much SOL.
# Needs REACCUMULATE_FEES_TO_SOL=true. Unset/off disables.
# FEE_SWEEP_THRESHOLD_SOL=0.01
# Options: Spot | Curve | BidAsk
STRATEGY=Spot
# Options: Auto | Min | Low | Medium | High | VeryHigh | UnsafeMax
PRIORITY_LEVEL=High
JUPITER_API_KEY=
POLL_INTERVAL_MS=60000
# Optional Telegram alerts + commands. Both empty means telegram disabled.
# Both set enables it; setting exactly one fails startup with ConfigError.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Fast command poll, separate from the main POLL_INTERVAL_MS cadence.
TELEGRAM_POLL_INTERVAL_MS=3000
